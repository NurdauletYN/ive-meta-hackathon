# Copy to `.env` (gitignored). Never commit real keys.

META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_TEXT=muse-spark-1.3
META_MODEL_IMAGE=muse-image-1.0
META_USAGE_LOG=ivebench/results/usage.jsonl
META_TIMEOUT_S=90
META_MAX_RETRIES=2

# Optional OpenAI-compatible Pilot (Baseten Muse Spark Open, etc.). No live call if unset.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# App Store Connect (local ship only). Never passed to a Pilot. Paths stay on this machine.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
APPLE_TEAM_ID=
BUNDLE_ID=

# Optional RevenueCat public SDK key for a device build (not passed to a Pilot).
# Prefer flutter_template/revenuecat_api_key.txt (gitignored) over committing a key.
# REVENUECAT_API_KEY=
