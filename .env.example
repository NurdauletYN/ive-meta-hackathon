# Copy this file to .env (gitignored) and fill in real values. Never commit .env.
# Get a key from the Meta Model API dashboard (https://dev.meta.ai). Format: LLM|<id>|<secret>

# Required. Read by src/meta_client/config.py. (The Meta docs call this MODEL_API_KEY; we use META_API_KEY.)
META_API_KEY=

# Base URL of the Meta Model API (see https://dev.meta.ai/docs/quickstart).
META_BASE_URL=https://api.meta.ai/v1

# Model IDs. Standard mode only: Contributor-mode IDs (suffix -contributor) are rejected on purpose.
META_MODEL_TEXT=muse-spark-1.3
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_SEGMENT=sam-3.1

# Optional: append one JSON line per API call (tokens, latency, cost). Leave empty to disable.
META_USAGE_LOG=ivebench/results/usage.jsonl
